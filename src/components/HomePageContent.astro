---
import type { Locale } from '../content/pages';
import { publicPath, routeFor } from '../content/pages';
import PersonaPaths from './PersonaPaths.astro';
import AppStoreLink from './AppStoreLink.astro';

const { locale } = Astro.props as { locale: Locale };
const fr = locale === 'fr';
---

<section class="container home-hero">
  <div class="hero-copy">
    <p class="eyebrow">Mata Ara <span aria-hidden="true">/</span> {fr ? 'Suivi réseau' : 'Network insights'}</p>
    <h1>{fr ? 'Votre réseau, en clair.' : 'Your network, made clear.'}</h1>
    <p class="lead">{fr ? 'Suivez votre enveloppe mobile, observez les compteurs réseau de votre appareil et gardez le cap sur un forfait de voyage.' : 'Track your mobile allowance, explore your device’s network counters, and stay on top of a travel plan.'}</p>
    <p class="hero-meta">{fr ? 'Pour un coup d’œil rapide, une observation détaillée ou une escapade connectée.' : 'For a quick check, a closer look, or a connected trip.'}</p>
    <AppStoreLink locale={locale} />
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="network-orbit orbit-one"></div>
    <div class="network-orbit orbit-two"></div>
    <div class="network-core"><img class="network-app-icon" src={publicPath('assets/mata-ara-app-icon.png')} width="56" height="56" alt="" /><span>{fr ? 'Activité réseau' : 'Network activity'}</span><b>{fr ? 'à votre rythme' : 'at your pace'}</b></div>
    <div class="atom-orbit atom-orbit-one"><span class="orbit-dot dot-one"></span></div>
    <div class="atom-orbit atom-orbit-two"><span class="orbit-dot dot-two"></span></div>
  </div>
</section>
<PersonaPaths locale={locale} />
<section class="container premium-callout" aria-labelledby="home-premium-title">
  <div><p class="eyebrow">{fr ? 'Version complète' : 'Premium'}</p><h2 id="home-premium-title">{fr ? 'Plus de contrôle, avec la version complète.' : 'More control with Premium.'}</h2>
    <p>{fr ? 'Ajoutez les alertes à 50 %, 75 % et 90 %, l’historique détaillé des vitesses par interface et la suppression de la bannière sur l’écran principal.' : 'Add 50%, 75%, and 90% threshold alerts, detailed per-interface speed history, and removal of the main-screen banner.'}</p></div>
  <a href={`${routeFor('features', locale)}#premium`}>{fr ? 'Comparer les versions' : 'Compare Free and Premium'} <span aria-hidden="true">→</span></a>
</section>
<section class="container home-detail">
  <div><p class="eyebrow">{fr ? 'Les essentiels' : 'The essentials'}</p><h2>{fr ? 'Des compteurs clairs, des choix qui restent les vôtres.' : 'Clear counters, with settings that stay yours.'}</h2></div>
  <p>{fr ? 'Configurez votre quota et votre cycle, choisissez vos alertes, puis consultez l’historique quand vous en avez besoin. Un achat unique permet de déverrouiller la version complète.' : 'Set your quota and cycle, choose your alerts, then check history when you need it. A one-time purchase unlocks the full version.'}<br/><a href={routeFor('features', locale)}>{fr ? 'Explorer toutes les fonctionnalités' : 'Explore all features'} <span aria-hidden="true">→</span></a></p>
</section>
<p class="container home-language"><a href={routeFor('home', locale === 'fr' ? 'en' : 'fr')} lang={locale === 'fr' ? 'en' : 'fr'}>{locale === 'fr' ? 'English version' : 'Version française'}</a></p>
