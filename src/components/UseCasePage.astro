---

import AppStoreLink from './AppStoreLink.astro';
import { useCases } from '../content/use-cases.mjs';
import { routeFor, type Locale, type PageId } from '../content/pages';

const { id, locale } = Astro.props as {
  id: Extract<PageId, 'mobileData' | 'networkCounters' | 'travelEsim'>;
  locale: Locale;
};
const contentId = id === 'mobileData' ? 'mobileData' : id === 'networkCounters' ? 'networkCounters' : 'travelEsim';
const content = useCases[contentId][locale];
const heading = content.title.replace(/ — Mata Ara$/, '');
const homeLabel = locale === 'fr' ? 'Accueil' : 'Home';
const sectionLabel = locale === 'fr' ? 'Comment Mata Ara vous aide' : 'How Mata Ara helps';
const limitLabel = locale === 'fr' ? 'À connaître' : 'What to know';
const relatedLabel = locale === 'fr' ? 'À découvrir aussi' : 'Explore related uses';
const relatedLinks = content.relatedIds.map((relatedId) => ({
  href: routeFor(relatedId, locale),
  label: useCases[relatedId][locale].title.replace(/ — Mata Ara$/, ''),
}));
const configuredSiteUrl = import.meta.env.SITE?.replace(/\/+$/, '');
const breadcrumbJsonLd = configuredSiteUrl && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: homeLabel,
      item: new URL(routeFor('home', locale), `${configuredSiteUrl}/`).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: heading,
      item: new URL(routeFor(id, locale), `${configuredSiteUrl}/`).href,
    },
  ],
};
---
  <article class="container use-case-page">
    <nav aria-label={locale === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}>
      <ol>
        <li><a href={routeFor('home', locale)}>{homeLabel}</a></li>
        <li aria-current="page">{heading}</li>
      </ol>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">Mata Ara</p>
      <h1>{heading}</h1>
      <p class="lead">{content.description}</p>
    </header>
    <section aria-labelledby="use-case-details">
      <h2 id="use-case-details">{sectionLabel}</h2>
      {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>
    <section aria-labelledby="use-case-limitations">
      <h2 id="use-case-limitations">{limitLabel}</h2>
      <p>{content.limitation}</p>
    </section>
    <section aria-labelledby="related-use-cases">
      <h2 id="related-use-cases">{relatedLabel}</h2>
      <ul>{relatedLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </section>
    <AppStoreLink locale={locale} />
  </article>
  {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
