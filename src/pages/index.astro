---
import SiteLayout from '../layouts/SiteLayout.astro';
import { routeFor } from '../content/pages';
---
<SiteLayout locale="fr" pageId="home">
  <section class="container home-hero">
    <p class="eyebrow">Mata Ara</p>
    <h1>Suivez vos données. Comprenez votre réseau.</h1>
    <p class="lead">Mata Ara vous aide à suivre votre consommation mobile et à observer l’activité réseau de votre appareil.</p>
    <p><a class="button-link" href={routeFor('home', 'fr')}>Découvrir Mata Ara</a></p>
    <p class="home-language"><a href={routeFor('home', 'en')} lang="en">English version</a></p>
  </section>
</SiteLayout>
