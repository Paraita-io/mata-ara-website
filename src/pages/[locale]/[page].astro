---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { allPageEntries, pages, type Locale, type PageId } from '../../content/pages';
export function getStaticPaths() {
  return allPageEntries().filter(({ slug }) => slug.length > 0)
    .map(({ id, locale, slug }) => ({ params: { locale, page: slug }, props: { id, locale } }));
}
const { id, locale } = Astro.props as { id: PageId; locale: Locale };
const page = pages[id].localized[locale];
---
<SiteLayout locale={locale} pageId={id}>
  <section class="container page-intro">
    <p class="eyebrow">Mata Ara</p>
    <h1>{page.title.replace(/ — Mata Ara$/, '')}</h1>
    <p class="lead">{page.description}</p>
  </section>
  <slot />
</SiteLayout>
