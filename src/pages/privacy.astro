---
import SiteLayout from '../layouts/SiteLayout.astro';
import PrivacyPolicy from '../components/PrivacyPolicy.astro';
import { routeFor } from '../content/pages';
---
<SiteLayout locale="en" pageId="privacy">
  <section class="container page-intro">
    <p class="eyebrow">Mata Ara</p>
    <h1>Privacy Policy</h1>
    <p class="lead">This address is used by the app and displays the policy in English. <a href={routeFor('privacy', 'fr')} lang="fr">Lire cette politique en français</a>.</p>
  </section>
  <PrivacyPolicy locale="en" />
</SiteLayout>
