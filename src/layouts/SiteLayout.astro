---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pages, routeFor, type Locale, type PageId } from '../content/pages';
const { locale, pageId, title, description } = Astro.props as {
  locale: Locale; pageId: PageId; title?: string; description?: string;
};
const page = pages[pageId];
const pageTitle = title ?? page.localized[locale].title;
const pageDescription = description ?? page.localized[locale].description;
const configuredSiteUrl = import.meta.env.SITE_URL?.replace(/\/$/, '');
const canonical = configuredSiteUrl ? new URL(routeFor(pageId, locale), `${configuredSiteUrl}/`).href : undefined;
const socialImage = configuredSiteUrl ? new URL('/assets/mata-ara-app-icon.png', `${configuredSiteUrl}/`).href : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f7f8f3" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="fr" href={configuredSiteUrl ? new URL(routeFor(pageId, 'fr'), `${configuredSiteUrl}/`).href : routeFor(pageId, 'fr')} />
    <link rel="alternate" hreflang="en" href={configuredSiteUrl ? new URL(routeFor(pageId, 'en'), `${configuredSiteUrl}/`).href : routeFor(pageId, 'en')} />
    <link rel="alternate" hreflang="x-default" href={configuredSiteUrl ? new URL(routeFor(pageId, 'fr'), `${configuredSiteUrl}/`).href : routeFor(pageId, 'fr')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mata Ara" />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}</a>
    <SiteHeader locale={locale} pageId={pageId} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter locale={locale} />
  </body>
</html>
